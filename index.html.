<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pagamento Pix</title>
<style>
*{box-sizing:border-box} body{font-family:Arial,sans-serif;margin:0;background:#f3f6f8;color:#17202a;display:flex;min-height:100vh;align-items:center;justify-content:center;padding:20px}
.card{background:white;max-width:420px;width:100%;padding:26px 22px;border-radius:20px;text-align:center;box-shadow:0 8px 30px #00000012}
h1{font-size:25px;margin:0 0 8px} p{line-height:1.45;color:#4b5563} img{width:min(100%,300px);height:auto;margin:12px auto}
button{width:100%;border:0;border-radius:12px;padding:15px 18px;font-size:16px;font-weight:700;background:#087f5b;color:white;margin-top:8px}
.note{font-size:12px;color:#6b7280;margin-top:18px}
</style>
</head>
<body>
<main class="card">
<h1>Pague com Pix</h1>
<p>Escaneie o QR Code no aplicativo do seu banco ou copie o código Pix abaixo.</p>
<img alt="QR Code Pix" src="data:image/png;base64,">
<button id="copy">Copiar código Pix</button>
<p id="status" role="status" aria-live="polite"></p>
<p class="note">Confira o nome do recebedor e os dados antes de confirmar o pagamento no banco.</p>
</main>
<script>
const pix = '00020101021126360014br.gov.bcb.pix0114+55229812246015204000053039865802BR5919GUSTAVO LIMA VARELA6009SAQUAREMA62070503***6304C346';
document.getElementById('copy').addEventListener('click', async () => {
  const status = document.getElementById('status');
  try {
    await navigator.clipboard.writeText(pix);
    status.textContent = 'Código Pix copiado! Abra o aplicativo do banco e escolha Pix Copia e Cola.';
  } catch (e) {
    const area = document.createElement('textarea');
    area.value = pix; document.body.appendChild(area); area.select();
    const ok = document.execCommand('copy'); area.remove();
    status.textContent = ok ? 'Código Pix copiado! Abra o aplicativo do banco e escolha Pix Copia e Cola.' : 'Não foi possível copiar automaticamente. Tente novamente.';
  }
});
</script>
</body>
</html>
